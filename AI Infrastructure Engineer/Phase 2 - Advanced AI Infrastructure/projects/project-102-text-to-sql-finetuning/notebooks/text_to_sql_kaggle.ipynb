  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!nvidia-smi --query-gpu=name,memory.total --format=csv\n",
    "from kaggle_secrets import UserSecretsClient\n",
    "s = UserSecretsClient()\n",
    "for name in (\"HF_TOKEN\", \"WANDB_API_KEY\"):\n",
    "    try:\n",
    "        s.get_secret(name); print(name, \"found\")\n",
    "    except Exception as e:\n",
    "        print(name, \"MISSING:\", e)"
   ]
  },
  {
